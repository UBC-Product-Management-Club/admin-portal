# PMC backend base URL (the portal calls $VITE_API_URL/api/v2/admin/...)
VITE_API_URL=http://localhost:8080

# Supabase Auth — public/anon key only, never the service-role key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLIC_KEY=

# Serve dev data from the in-app mock API instead of the backend
VITE_USE_MOCKS=true

# Dev only: skip login with a placeholder exec (ignored in production builds)
VITE_SKIP_AUTH=false
